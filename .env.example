# OpsPilot Configuration
# Copy to .env and fill in your values

# LLM Provider: mock | gemini | openai
LLM_PROVIDER=mock

# Gemini API (required if LLM_PROVIDER=gemini)
# Get your API key from https://makersuite.google.com/app/apikey
GEMINI_API_KEY=

# OpenAI API (required if LLM_PROVIDER=openai)
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Model selection (optional, defaults shown)
# For Gemini: gemini-2.0-flash-exp, gemini-1.5-pro, gemini-1.5-flash
GEMINI_MODEL=gemini-2.0-flash-exp

# For OpenAI: gpt-4o, gpt-4o-mini, gpt-3.5-turbo
OPENAI_MODEL=gpt-4o-mini

# API Server
HOST=0.0.0.0
PORT=8000

# Environment: development | production
ENVIRONMENT=development

# Rate Limiting (requests per window)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60

# Cache TTL (seconds)
CACHE_TTL_SECONDS=3600

# Retrieval
MIN_RELEVANCE_SCORE=0.15
TOP_K=5

# Logging
LOG_LEVEL=INFO

# Knowledge Base Path (optional, defaults to knowledge_base/runbooks.json)
KNOWLEDGE_BASE_PATH=knowledge_base/runbooks.json

# CORS Settings (comma-separated lists)
# Development defaults allow all origins with credentials for convenience.
# PRODUCTION: When CORS_ALLOW_CREDENTIALS=true, CORS_ALLOWED_ORIGINS MUST be an explicit list (not *).
# PRODUCTION: If using wildcard origins (*), set CORS_ALLOW_CREDENTIALS=false.
CORS_ALLOWED_ORIGINS=*
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOWED_METHODS=*
CORS_ALLOWED_HEADERS=*

# Support Phone (shown when knowledge base cannot answer)
SUPPORT_PHONE=+1-555-0200